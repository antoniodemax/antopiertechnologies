# Server-only secrets for the consultation API. Never expose these to the browser.
PORT=8787
RESEND_API_KEY=
CONSULTATION_TO_EMAIL=
CONSULTATION_FROM_EMAIL=            # must be on a domain verified in Resend
TURNSTILE_SECRET_KEY=               # optional; when unset, Turnstile verification is skipped
ALLOWED_ORIGIN=http://localhost:5173  # comma-separated list of origins allowed to call the API
