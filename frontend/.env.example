# Public (exposed to the browser). Set per environment in Vercel.
VITE_API_URL=                       # backend origin, e.g. https://api.your-domain. Leave empty in dev (proxied) or same-domain deploys.
VITE_SITE_ENV=production            # development | preview | production (placeholders render outside production)
VITE_SITE_URL=                      # e.g. https://your-domain — enables canonical and absolute Open Graph URLs
VITE_BOOKING_CONSULTATION_URL=      # scheduler link offered after a consultation request (optional)
VITE_BOOKING_DISCOVERY_URL=         # scheduler link for "Schedule a Discovery Call" (falls back to /contact)
VITE_TURNSTILE_SITE_KEY=            # Cloudflare Turnstile site key (optional)
