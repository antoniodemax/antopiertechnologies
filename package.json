{
  "name": "antopiertechnologies",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": ["shared", "backend", "frontend"],
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"npm:dev -w frontend\" \"npm:dev -w backend\"",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "build": "npm run build -w frontend",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "npm run test -w frontend && npm run test -w backend"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0"
  },
  "engines": {
    "node": ">=22"
  }
}
